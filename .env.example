# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"

# Supabase Configuration (Client - Public Anon Key & Project URL)
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
VITE_ADMIN_EMAIL=

# Supabase Service Role Key (Server / Edge Functions ONLY - never expose to client)
SUPABASE_SERVICE_ROLE_KEY=

# Gemini API Key (Server ONLY — injected via Settings > Secrets)
GEMINI_API_KEY=

